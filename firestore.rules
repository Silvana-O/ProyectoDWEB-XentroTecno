rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // USUARIOS
    // ==========================================
    match /usuarios/{userId} {

      // Cada usuario puede consultar su propio documento.
      allow get: if request.auth != null
        && request.auth.uid == userId;

      allow list: if false;

      // El registro público solo permite crear clientes.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rol == "cliente";

      // Permite actualizar datos propios sin cambiar el rol ni el UID.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.rol == resource.data.rol;

      // No se permite borrar usuarios desde el cliente.
      allow delete: if false;
    }


    // ==========================================
    // PRODUCTOS
    // ==========================================
    match /productos/{productoId} {

      // El catálogo es público.
      allow read: if true;

      // Crear y eliminar productos requiere rol de administrador.
      allow create, delete: if request.auth != null
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.rol == "admin";

      // Los administradores pueden editar productos.
      // Los clientes solo pueden descontar stock mediante
      // una operación vinculada a un pedido y a su contador.
      allow update: if request.auth != null
        && (
          get(
            /databases/$(database)/documents/usuarios/$(request.auth.uid)
          ).data.rol == "admin"

          ||

          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(["stock", "ultimoPedidoId"])

            && resource.data.stock is int
            && request.resource.data.stock is int
            && request.resource.data.stock >= 0
            && request.resource.data.stock < resource.data.stock

            && request.resource.data.ultimoPedidoId is string

            && existsAfter(
              /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
            )

            && getAfter(
              /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
            ).data.usuarioId == request.auth.uid

            && getAfter(
              /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
            ).data.estado == "aprobado_simulado"

            && getAfter(
              /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
            ).data.stockProductos.keys().hasAll([productoId])

            && getAfter(
              /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
            ).data.stockProductos[productoId].cantidad is int

            && getAfter(
              /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
            ).data.stockProductos[productoId].cantidad
              == resource.data.stock - request.resource.data.stock

            && getAfter(
              /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
            ).data.stockProductos[productoId].precio is number

            && getAfter(
              /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
            ).data.stockProductos[productoId].precio
              == resource.data.precio

            && getAfter(
              /databases/$(database)/documents/contadores/pedidos
            ).data.ultimoPedidoId
              == request.resource.data.ultimoPedidoId
          )
        );
    }


    // ==========================================
    // CONTADORES
    // ==========================================
    match /contadores/{contadorId} {

      // Se necesita leer el contador para ejecutar la transacción.
      allow get: if request.auth != null;
      allow list: if false;

      // Crear el contador solo al registrar el primer pedido.
      allow create: if request.auth != null
        && contadorId == "pedidos"
        && request.resource.data.keys().hasAll([
          "ultimoNumero",
          "ultimoPedidoId"
        ])
        && request.resource.data.keys().hasOnly([
          "ultimoNumero",
          "ultimoPedidoId"
        ])
        && request.resource.data.ultimoNumero is int
        && request.resource.data.ultimoNumero == 1
        && request.resource.data.ultimoPedidoId is string

        && existsAfter(
          /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
        )

        && getAfter(
          /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
        ).data.usuarioId == request.auth.uid

        && getAfter(
          /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
        ).data.numeroPedido == request.resource.data.ultimoNumero;

      // Solo se permite incrementar el contador en una unidad
      // y vincularlo con un pedido creado en la misma transacción.
      allow update: if request.auth != null
        && contadorId == "pedidos"
        && request.resource.data.keys().hasAll([
          "ultimoNumero",
          "ultimoPedidoId"
        ])
        && request.resource.data.keys().hasOnly([
          "ultimoNumero",
          "ultimoPedidoId"
        ])
        && resource.data.ultimoNumero is int
        && request.resource.data.ultimoNumero is int
        && request.resource.data.ultimoNumero
          == resource.data.ultimoNumero + 1
        && request.resource.data.ultimoPedidoId is string

        && existsAfter(
          /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
        )

        && getAfter(
          /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
        ).data.usuarioId == request.auth.uid

        && getAfter(
          /databases/$(database)/documents/pedidos/$(request.resource.data.ultimoPedidoId)
        ).data.numeroPedido == request.resource.data.ultimoNumero;

      allow delete: if false;
    }


    // ==========================================
    // PEDIDOS
    // ==========================================
    match /pedidos/{pedidoId} {

      // Crear pedidos propios vinculados al contador.
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          "numeroPedido",
          "usuarioId",
          "productos",
          "stockProductos",
          "total",
          "metodoPago",
          "estado",
          "entorno",
          "fecha"
        ])
        && request.resource.data.keys().hasOnly([
          "numeroPedido",
          "usuarioId",
          "productos",
          "stockProductos",
          "total",
          "metodoPago",
          "estado",
          "entorno",
          "fecha"
        ])

        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.estado == "aprobado_simulado"
        && request.resource.data.entorno == "simulacion"
        && request.resource.data.metodoPago in [
          "tarjeta",
          "transferencia"
        ]

        && request.resource.data.productos is list
        && request.resource.data.productos.size() > 0

        && request.resource.data.stockProductos is map
        && request.resource.data.stockProductos.keys().size() > 0

        && request.resource.data.total is number
        && request.resource.data.total >= 0

        && request.resource.data.numeroPedido is int
        && request.resource.data.numeroPedido > 0

        && existsAfter(
          /databases/$(database)/documents/contadores/pedidos
        )

        && getAfter(
          /databases/$(database)/documents/contadores/pedidos
        ).data.ultimoPedidoId == pedidoId

        && getAfter(
          /databases/$(database)/documents/contadores/pedidos
        ).data.ultimoNumero
          == request.resource.data.numeroPedido;

      // Consultar únicamente pedidos propios.
      // Para listarlos, las consultas deben filtrar por usuarioId.
      allow get, list: if request.auth != null
        && resource.data.usuarioId == request.auth.uid;

      // Los pedidos registrados son inmutables.
      allow update, delete: if false;
    }


    // ==========================================
    // RESEÑAS
    // ==========================================
    match /resenas/{resenaId} {

      // Las reseñas publicadas son visibles para todos.
      allow read: if true;

      // Crear reseñas asociadas al usuario autenticado.
      allow create: if request.auth != null
        && request.resource.data.usuarioId == request.auth.uid;

      // El propietario puede modificar su reseña,
      // pero no transferirla a otro usuario.
      allow update: if request.auth != null
        && resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioId == resource.data.usuarioId;

      // Solo el propietario puede eliminar su reseña.
      allow delete: if request.auth != null
        && resource.data.usuarioId == request.auth.uid;
    }

  }
}
